// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model NewsArticle {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  language         String    @default("en")
  category         String
  tags             String[]
  excerpt          String    @db.Text
  content          String    @db.Text
  authorName       String
  authorRole       String?
  chapter          String?
  featured         Boolean   @default(false)
  published        Boolean   @default(false)
  publishedAt      DateTime?
  heroImageUrl     String?
  heroImageAlt     String?
  heroImageCaption String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([category])
  @@index([published])
  @@index([publishedAt])
  @@index([language])
  @@map("news_articles")
}

model Affiliate {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  region    String
  // Full display label for `region`, e.g. "Northwest Chapter" — kept as a
  // separate nullable field rather than replacing `region`, since `region`
  // (the bare code like "NORTHWEST") is depended on throughout the app:
  // filtering, the CSV importer, deep links (?region=...), the admin
  // affiliate form, and the regionLabels lookup table. Valid values:
  // "Northwest Chapter", "Southwest Chapter", "Littoral Chapter",
  // "Centre Chapter", "West Chapter", "Adamawa Chapter", "North Chapter",
  // "Far North Chapter", "East Chapter", "South Chapter".
  chapter   String?
  city      String?
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)

  // Chapter Profile Form fields — populated via the admin "Upload Chapter
  // Profiles" tool (manual entry or best-effort extraction from an uploaded
  // document), and displayed on the public /affiliates/[code] profile page.
  yearEstablished        Int?
  briefHistory           String?    @db.Text
  totalMembers           Int?
  branchCount            Int?
  memberCreditUnionCount Int?
  services               String[]   @default([])
  chapterPresident       String?
  chapterSupervisor      String?
  boardSize              Int?
  staffCount             Int?
  // Array of { name: string, code: string } — a chapter's self-reported
  // member credit unions, as listed on its Chapter Profile Form. Distinct
  // from the top-level Affiliate records, which each have their own
  // independent code/region/etc.
  memberCreditUnions     Json?
  profileUpdatedAt       DateTime?
  // "pending" | "approved" | "rejected" — gates public visibility of the
  // profile fields above on /affiliates/[code]. Defaults to "pending" so
  // every submitted profile requires admin sign-off before going live.
  profileStatus          String?    @default("pending")
  // Set by the reviewer when rejecting a submission; not part of the
  // Chapter Profile Form fields above, and never touched by a chapter's
  // own submission — only by the admin review action.
  profileReviewNote      String?    @db.Text

  documents AffiliateDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region])
  @@index([name])
  @@index([profileStatus])
  @@map("affiliates")
}

// Tracks a chapter profile document uploaded for a given affiliate, so
// staff can find and review what was submitted (and what — if anything —
// was auto-extracted from it) after the fact.
model AffiliateDocument {
  id            String   @id @default(cuid())
  affiliateId   String
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  fileName      String
  fileType      String
  fileSize      Int
  storagePath   String
  status        String   @default("pending_review")
  extractedText String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([affiliateId])
  @@map("affiliate_documents")
}

model Resource {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  category      String
  fileType      String?
  fileSize      Int?
  fileUrl       String?
  downloadCount Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@map("resources")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}
